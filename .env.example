# Pfad zur SQLite-Datenbank
DATABASE_URL=local.db

# Verzeichnis für persistente Daten (Bilder, Picnic-Auth-Key); im Container /data
DATA_DIR=.

# Zugangsdaten für den Picnic-Account (für Warenkorb-Befüllung und Produktsuche)
PICNIC_USERNAME=
PICNIC_PASSWORD=

# Erster Admin-Benutzer. Wird nur beim allerersten Start angelegt, wenn noch
# kein Benutzer existiert. Danach wird die Verwaltung über die App gemacht.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
ADMIN_EMAIL=
