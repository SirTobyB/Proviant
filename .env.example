# Pfad zur SQLite-Datenbank
DATABASE_URL=local.db

# Verzeichnis für persistente Daten (Bilder, Picnic-Auth-Key); im Container /data
DATA_DIR=.

# Zugangsdaten für den Picnic-Account (für Warenkorb-Befüllung und Produktsuche)
PICNIC_USERNAME=
PICNIC_PASSWORD=

# Erster Admin-Benutzer. Wird nur beim allerersten Start angelegt, wenn noch
# kein Benutzer existiert. Danach wird die Verwaltung über die App gemacht.
# Das Passwort braucht mindestens 12 Zeichen (sonst wird kein Admin angelegt);
# am besten zufällig aus einem Passwort-Manager. Einen Namen wählen, der sich
# nicht erraten lässt — „admin" probiert jeder als Erstes.
# Werte mit $ oder # in einfache Anführungszeichen setzen: ADMIN_PASSWORD='…'
ADMIN_USERNAME=
ADMIN_PASSWORD=
ADMIN_EMAIL=
