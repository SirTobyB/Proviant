{
	"name": "proviant",
	"description": "Self-hosted family web app for pantry management with Picnic integration",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/SirTobyB/Proviant.git"
	},
	"private": true,
	"version": "2.3.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"db:push": "drizzle-kit push",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "drizzle-kit migrate",
		"db:studio": "drizzle-kit studio",
		"test": "vitest run",
		"test:watch": "vitest"
	},
	"devDependencies": {
		"@sveltejs/adapter-node": "^5.5.4",
		"@sveltejs/kit": "^2.70.3",
		"@sveltejs/vite-plugin-svelte": "^7.3.0",
		"@tailwindcss/forms": "^0.5.11",
		"@tailwindcss/vite": "^4.3.3",
		"@types/better-sqlite3": "^7.6.13",
		"@types/node": "^22",
		"drizzle-kit": "^0.31.10",
		"drizzle-orm": "^0.45.2",
		"svelte": "^5.57.0",
		"svelte-check": "^4.7.6",
		"tailwindcss": "^4.3.0",
		"typescript": "^6.0.3",
		"vite": "^8.2.2",
		"vitest": "^5.0.0"
	},
	"overrides": {
		"@esbuild-kit/core-utils": {
			"esbuild": "^0.25.12"
		}
	},
	"dependencies": {
		"barcode-detector": "^3.2.2",
		"better-sqlite3": "^12.10.0",
		"picnic-api": "^4.9.0",
		"zxing-wasm": "3.1.3"
	}
}
